# This workspace needs Solidity source, not a JavaScript toolchain.
#
# Safe's packages declare `ethers` as a peer dependency, and npm 7+ resolves peers
# automatically — which pulled a JS crypto stack into a tree that exists only so
# `forge` can read `.sol` files. Among them `elliptic`, carrying a critical ECDSA
# private-key-extraction advisory, and `ws`. Nothing here imports any of it; there
# is no JavaScript in this workspace at all.
#
# `legacy-peer-deps` rather than `omit=peer`: the latter skips *installing* peers
# but still records the full graph in the lockfile, which is what Dependabot reads,
# so the alerts remain and the vulnerable code is one `npm ci --include=peer` away.
# This keeps them out of the resolution entirely — 2 packages instead of 46.
#
# Set here rather than as a CI flag so it holds for every caller: a contributor
# running `npm ci` by hand, and Dependabot's own resolution.
legacy-peer-deps=true
